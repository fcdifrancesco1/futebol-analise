# Copie para .env.local; nunca preencha segredos neste arquivo versionado.
FOOTBALL_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
# Gere valores aleatórios independentes, com pelo menos 32 caracteres.
CRON_SECRET=
RATE_LIMIT_SECRET=
